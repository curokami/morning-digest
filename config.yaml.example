# Copy to config.yaml. Never store secrets here.
app:
  timezone: "Asia/Tokyo"
  language: "ja"
  max_articles_per_digest: 10

sources:
  medium:
    enabled: true
    feeds:
      - "https://medium.com/feed/@example"
      # Weighted feeds are selected first. Default weight is 1.0.
      - url: "https://medium.com/feed/@favorite_writer"
        weight: 2.0
    # A rule applies only when every listed RSS source tag is present.
    tag_weight_rules:
      - all: ["Elixir", "Programming"]
        weight: 2.0
    digest:
      max_articles: 10
      subject_prefix: "Morning Digest"
  python_weekly:
    enabled: true
    archive_url: "https://www.pythonweekly.com/archive"
    weight: 1.0
    schedule:
      frequency: "weekly"
      # Friday in app.timezone avoids checking before Thursday's Issue is published.
      weekday: "friday"
    sections:
      - "News"
      - "Articles, Tutorials and Talks"
    digest:
      max_articles: 5
      subject_prefix: "🐍 Python Weekly Digest"

ai:
  provider: "openai"
  model: "REPLACE_WITH_MODEL_NAME"
  summary:
    min_sentences: 3
    max_sentences: 5
  reading_priority:
    weights:
      relevance: 0.40
      novelty: 0.20
      impact: 0.20
      actionability: 0.20

taxonomy:
  path: "data/taxonomy.yaml"
  fallback_tag: "Uncategorized"
  max_tags_per_article: 3

persistence:
  backend: "json"
  path: "data/processed_articles.json"

digest:
  format: "html"
  sort_by: "reading_priority"
  sort_order: "descending"

delivery:
  provider: "gmail"
  sender:
    name: "Morning Digest"
  subject:
    prefix: "Morning Digest"

logging:
  level: "INFO"
  path: "logs/morning-digest.log"
