<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.curokami.morning-digest</string>
  <key>ProgramArguments</key>
  <array>
    <string>UV_EXECUTABLE</string>
    <string>run</string>
    <string>morning-digest</string>
    <string>--config</string>
    <string>PROJECT_DIRECTORY/config.yaml</string>
  </array>
  <key>WorkingDirectory</key>
  <string>PROJECT_DIRECTORY</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>40</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>PROJECT_DIRECTORY/logs/launchd.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>PROJECT_DIRECTORY/logs/launchd.stderr.log</string>
</dict>
</plist>
